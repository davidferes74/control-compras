# Solo en el servidor (Vercel → Settings → Environment Variables). Nunca con prefijo NEXT_PUBLIC.
DATABASE_URL=
APP_ACCESS_USERNAME=sentidino
APP_ACCESS_PASSWORD=
# Aleatorio, 32 caracteres o más.
SESSION_SECRET=
ORGANIZATION_ID=control-compras

# Lectura de documentos con Claude.
ANTHROPIC_API_KEY=
# Opcionales: modelo y lecturas máximas al día.
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=40

# Google (Gmail lectura + Drive limitado). Clave de cifrado: 64 caracteres hexadecimales, estable.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave de API para el selector de carpetas (Google Picker).
GOOGLE_API_KEY=
# Solo si el dominio no es https://control-compras-sentidino.vercel.app
APP_URL=

# Tarea diaria (Vercel Cron): revisa Gmail, lee con IA, archiva en Drive y actualiza la hoja.
CRON_SECRET=
