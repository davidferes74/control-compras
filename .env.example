# Set only on the server; never prefix secrets with NEXT_PUBLIC.
DATABASE_URL=
APP_ACCESS_USERNAME=sentidino
APP_ACCESS_PASSWORD=
SESSION_SECRET=
ORGANIZATION_ID=recepciones-ia
# Configurar las integraciones que se vayan a usar en la nueva instalación.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Revisión programada del correo (Vercel Cron). Sin ella, el correo solo se revisa a mano.
CRON_SECRET=

# Correo: clave aleatoria de 64 caracteres hexadecimales; mantener estable.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Trigger externo opcional, distinto del cron de Vercel.
JOB_TRIGGER_SECRET=
# Acceso opcional desde Sentidiño BI.
SENTIDINO_MODULE_SECRET=
SENTIDINO_BI_URL=
# Solo si se utiliza configuración Odoo heredada del BI en servidor.
SENTIDINO_BI_CONFIG=
DATA_DIR=
# Comprobación opcional contra el NUEVO despliegue.
SMOKE_BASE_URL=
SMOKE_USERNAME=
SMOKE_PASSWORD=
